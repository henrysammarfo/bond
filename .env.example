# Copy to .env.local (never commit secrets)
# If DATABASE_URL contains &, wrap the value in double quotes.

DATABASE_URL=
SESSION_SECRET=
# Used to seal per-org BYO keys (falls back to SESSION_SECRET)
INTEGRATIONS_ENCRYPTION_KEY=

CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_WALLET_ADDRESS=
# EVM private key exported from the AgentKit / CDP Avalanche wallet (required to sign)
AGENT_PRIVATE_KEY=
CDP_WALLET_PRIVATE_KEY=
CDP_IDEMPOTENCY_KEY=

OPENSERV_API_KEY=
OPENSERV_API_BASE_URL=https://inference-api.openserv.ai
OPENSERV_MODEL=gpt-5.4-mini

AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_USE_TOR=1
AGENTROUTER_TOR_SOCKS=socks5h://127.0.0.1:9050
AGENTROUTER_MODEL=deepseek-v4-flash

IXS_API_BASE_URL=https://api-v2.ixs.finance
IXS_MCP_URL=https://api-v2.ixs.finance/mcp
IXS_PRIMARY_VAULT_ID=6a952729732c2b84b55ce89d
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

TAVILY_API_KEY=
TINYFISH_API_KEY=
VENICE_API_KEY=

# Neon
NEON_PROJECT_ID=

# Set to 1 only when running the funded mainnet deposit e2e
LIVE_DEPOSIT=0
